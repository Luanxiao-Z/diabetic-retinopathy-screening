        </dependency>
        <dependency>
            <groupId>cn.edu.fzu.drs</groupId>
            <artifactId>drs-module-common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>cn.edu.fzu.drs</groupId>
            <artifactId>drs-module-security</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- MinIO 对象存储 Java 客户端（S3 兼容），版本由 BOM 管理 -->
        <dependency>
            <groupId>io.minio</groupId>
            <artifactId>minio</artifactId>
        </dependency>
        <!-- Excel 导出（本期仅导出 Excel，见 spec 导出约定） -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
