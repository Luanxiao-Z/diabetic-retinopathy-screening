<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.4</version>
        <relativePath/>
    </parent>

    <groupId>cn.edu.fzu.drs</groupId>
    <artifactId>drs-backend</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>drs-backend</name>
    <description>糖尿病视网膜病变（DR）智能筛查系统 —— 后端聚合工程</description>

    <modules>
        <module>drs-dependencies/drs-dependencies-bom</module>
        <module>drs-module/drs-module-common</module>
        <module>drs-module/drs-module-security</module>
        <module>drs-module/drs-module-system</module>
        <module>drs-module/drs-module-screening</module>
        <module>drs-app/drs-app-server</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.parameters>true</maven.compiler.parameters>
        <mybatis-plus.version>3.5.11</mybatis-plus.version>
        <knife4j.version>4.5.0</knife4j.version>
        <jedis.version>5.2.0</jedis.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>cn.edu.fzu.drs</groupId>
                <artifactId>drs-dependencies-bom</artifactId>
                <version>${project.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- POI 5.3.0 编译依赖 commons-compress 1.26.2，而 Spring Boot 父 BOM 将其管理为 1.24.0，
                 二者方法签名不兼容（ZipArchiveOutputStream.putArchiveEntry），导致 Excel 导出 NoSuchMethodError。
                 此处直接锁定 POI 所需版本，覆盖 Spring Boot 父 BOM 的 1.24.0。 -->
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-compress</artifactId>
                <version>1.26.2</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
