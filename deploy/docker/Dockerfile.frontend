# 前端镜像（多阶段）：node 构建 + nginx 托管
FROM node:22-alpine AS build
WORKDIR /app
RUN corepack enable
COPY frontend/web/package.json ./
RUN yarn install
COPY frontend/web/ ./
RUN yarn build

FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY deploy/nginx/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
