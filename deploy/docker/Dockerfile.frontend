# ============================================================================
# 前端镜像（多阶段构建）
#   构建阶段：Node 22 + Yarn 打包静态资源
#   运行阶段：Nginx 托管 dist，并反代 /api 到后端容器
# 构建上下文为仓库根目录（见 deploy/docker-compose.yml 的 context: ..）
# ============================================================================
FROM node:22-alpine AS build
WORKDIR /build

RUN corepack enable

# 依赖层缓存：先拷清单与 registry 配置（frontend/web/.yarnrc 指向国内镜像）
COPY frontend/web/package.json frontend/web/.yarnrc* ./
RUN yarn install --network-timeout 600000

COPY frontend/web/ ./
RUN yarn build

FROM nginx:1.27-alpine
ENV TZ=Asia/Shanghai

# 项目自定义 Nginx 配置（SPA 回退 + /api 反代 + 上传体积）
COPY deploy/nginx/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /build/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=15s --timeout=5s --retries=5 \
  CMD wget -q -O /dev/null http://127.0.0.1/ || exit 1
