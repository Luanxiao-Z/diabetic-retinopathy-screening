# ============================================================================
# 模型服务镜像（FastAPI + PyTorch）
#   注意：
#   1. requirements.txt 顶部通过 --extra-index-url 拉取 CUDA(cu130) 版 PyTorch，
#      镜像体积较大；**纯 CPU 部署**请将末两行改为 +cpu 轮子（见 requirements.txt 注释）。
#   2. 容器内一般无 NVIDIA 运行时；如需 GPU 推理，请配合 NVIDIA Container Toolkit
#      并在 compose 中声明 runtime/devices，或改用 CPU 轮子。
#   3. 训练权重 models/best_model.pth 不入镜像（.gitignore 已忽略本地权重），
#      由 compose 挂载 ../model-service/models 提供；缺失时服务回退随机初始化。
#   4. 模块入口为 app.main:app（app/ 为包目录），切勿写成 main:app。
# ============================================================================
FROM python:3.12-slim
WORKDIR /app

ENV TZ=Asia/Shanghai \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

# 健康检查需要 curl；libgomp1 为 PyTorch 运行时依赖
RUN apt-get update \
 && apt-get install -y --no-install-recommends curl libgomp1 \
 && rm -rf /var/lib/apt/lists/*

COPY model-service/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY model-service/app ./app
COPY model-service/training ./training

# 权重与指标目录（由 compose 挂载覆盖）
RUN mkdir -p /app/models

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
