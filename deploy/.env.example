# ============================================================================
# 容器化部署环境变量模板
# ----------------------------------------------------------------------------
# 用法：
#   cp deploy/.env.example deploy/.env
#   然后按需修改下方取值；deploy/.env 已被 .gitignore 忽略，**请勿提交真实密码**。
#
# 启动：
#   docker compose -f deploy/docker-compose.yml --env-file deploy/.env up -d --build
#
# 模型服务默认不构建（由宿主机 Python 3.13 常驻 8000），需要容器化时追加 --profile model
# ============================================================================

# ---------------- 镜像源 ----------------
# 留空或设为 docker.io 使用官方源；中国大陆建议使用加速源以缩短拉取时间
# 已实测可用：docker.m.daocloud.io（对 library/* 有效）
DOCKER_REGISTRY=docker.m.daocloud.io
# 对象存储镜像：MinIO 官方社区镜像已迁出 Docker Hub，默认使用 Pigsty 维护的 fork（Silo）。
# Silo 的 S3 API、MINIO_* 环境变量、启动命令与控制台端口均与 MinIO 兼容，可直接替换；
# 如需改回其他实现，可指定自建镜像或 quay.io/minio/minio:RELEASE.xxx
MINIO_IMAGE=pgsty/silo:latest

# ---------------- 数据库 ----------------
DB_NAME=dr_screening
DB_PASSWORD=change-me-db-password

# ---------------- Redis ----------------
REDIS_PASSWORD=change-me-redis-password

# ---------------- MinIO（对象存储）----------------
MINIO_ACCESS_KEY=change-me-minio-access
MINIO_SECRET_KEY=change-me-minio-secret

# ---------------- 宿主机端口映射（左侧为宿主机端口，可改）----------------
# 3306 常被本机 MySQL 占用，冲突时改为 3307 等
MYSQL_PORT=3306
REDIS_PORT=26379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MODEL_PORT=8000
BACKEND_PORT=8080
WEB_PORT=80

# ---------------- 服务间地址 ----------------
# 预签名 URL 的对外地址：浏览器实际访问对象存储的地址（容器部署时不能用 minio:9000）。
# 后端已显式指定 region，生成预签名无需连接该地址，因此它只需浏览器可达即可。
# 若从其他主机访问系统，请改为该主机的 IP 或域名。
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
# 对象存储 region（MinIO/Silo 默认 us-east-1）
DRS_MINIO_REGION=us-east-1
# 后端访问模型服务的地址：宿主机常驻时为 host.docker.internal:8000；
# 使用 --profile model 容器化时改为 http://model-service:8000
MODEL_SERVICE_BASE_URL=http://host.docker.internal:8000

# ---------------- 模型服务构建（仅 --profile model 时生效）----------------
# true 使用 CUDA(cu130) 轮子（镜像约 5–7 GB）；false 使用 CPU 轮子（约 1.5–2 GB）
USE_GPU_TORCH=false
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
